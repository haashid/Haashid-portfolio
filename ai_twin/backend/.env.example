# Copy this file to .env and fill in your values
# Get your Gemini API key free at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Your name (shown in chat UI and persona prompt)
YOUR_NAME=Your Name

# One-line tagline shown under your name in the UI
YOUR_TAGLINE=Software Engineer · Passionate Builder · Problem Solver

# Brief description of who you are (for the chat intro)
YOUR_BIO=I am a software engineer with experience in...

# Path to your ChromaDB storage (default is fine)
CHROMA_DB_PATH=./chroma_db

# Model to use for chat (gemini-1.5-flash is free)
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Model to use for embeddings
GEMINI_EMBED_MODEL=models/text-embedding-004

# Temperature for responses (0.0 = precise, 1.0 = creative)
TEMPERATURE=0.7

# Number of relevant chunks to retrieve per query
TOP_K_RESULTS=5
